    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'date_strings': ['2023-09-15', '2023/10/26', '15.11.2023']\n",
    "})\n",
    "\n",
    "# Pandas will attempt to infer the format for each entry\n",
    "df['datetime_column'] = pd.to_datetime(df['date_strings'], format='mixed')\n",
    "print(df)"
